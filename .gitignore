# dependencies
node_modules

# output
out
dist
*.tgz

# code coverage
coverage
*.lcov

# logs
logs
*.log

# dotenv environment variable files
.env
.env.*.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# editors
.idea
.vscode

# macOS
.DS_Store

# spec-review atomic-write temp files
*.md.tmp-*

# label rows written while trying the demo task. Real label data never lives in
# git at all (it belongs under ~/.local/share/labels); only the demo's fictional
# stand-in file is tracked.
examples/labels/*/labels/*
examples/labels/*/comments/*
!examples/labels/demo-task/labels/opus-standin.jsonl

# Regenerated reviewer-specific speaker truth
examples/labels/*/build/

# npm run at the repository root (instead of tools/spec-review) leaves an empty
# lockfile behind; the only real one is tools/spec-review/package-lock.json.
/package-lock.json
